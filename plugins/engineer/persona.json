{
  "schema": "persona-declaration-1.4",
  "name": "engineer",
  "deliverable_noun": "deliverable",
  "runtime_footer_floor": "0.63.0",
  "capabilities": {
    "dispatch_target": true,
    "commit_surface": true,
    "legacy_homes": true,
    "profile_presets": false
  },
  "decide": {
    "fallback": {
      "preset_id": "default",
      "axes": [
        {
          "id": "essence",
          "labels": {
            "en": "Essence",
            "ko": "본질"
          },
          "question": "Does this solve the fundamental problem, or just a symptom?",
          "role": "decisive",
          "gate": false
        },
        {
          "id": "foundation",
          "labels": {
            "en": "Foundation",
            "ko": "근본"
          },
          "question": "Is this architecturally sound as a long-term base?",
          "role": "decisive",
          "gate": false
        },
        {
          "id": "standards",
          "labels": {
            "en": "Standards",
            "ko": "표준"
          },
          "question": "Does it align with industry standards and specifications?",
          "role": "supporting",
          "gate": false
        },
        {
          "id": "best-practice",
          "labels": {
            "en": "Best Practice",
            "ko": "정석"
          },
          "question": "Is it the canonical approach recommended by authoritative sources?",
          "role": "supporting",
          "gate": false
        },
        {
          "id": "practical-fit",
          "labels": {
            "en": "Practical Fit",
            "ko": "실용성"
          },
          "question": "Is it the best choice for this project's specific constraints?",
          "role": "supporting",
          "gate": false
        }
      ]
    },
    "size_presets": {
      "minor": "compact",
      "standard": "default",
      "major": "nine-axis"
    },
    "tie_break": [
      "practical-fit"
    ]
  },
  "verbs": {
    "investigate": {
      "profiles": [
        "analysis",
        "root-cause",
        "cited-brief"
      ],
      "default_profile": "analysis",
      "request_placeholder": "one-line scrubbed user request",
      "ensemble_type": "investigate",
      "brief_profile": "cited-brief",
      "brief_ensemble_type": "research-scan",
      "brief_file": "research_brief.md",
      "output_root_env": "RESEARCH_OUTPUT_ROOT",
      "artifact": [
        "### Findings",
        "",
        "<top findings with file paths and line numbers>",
        "",
        "### Brief saved",
        "",
        "<cited-brief profile only: absolute path to research_brief.md; drop this section for analysis and root-cause>"
      ],
      "rationale_gate": "본질/근본 (essence/foundation) + Standards/Root-Cause gate",
      "evidence_pointers": "phase notes / files / artifacts",
      "next_action": "<one-sentence imperative for next verb>"
    },
    "frame": {
      "request_placeholder": "one-line scrubbed user request",
      "artifact": [
        "### Frame model",
        "",
        "Problem statement: ...",
        "Goals: ...",
        "Audience: ...",
        "Constraints: ...",
        "Success criteria: ...",
        "Risks: ...",
        "Out of scope: ..."
      ],
      "rationale_gate": "본질/근본 (essence/foundation) + Standards/Root-Cause gate",
      "evidence_pointers": "phase notes / files / artifacts",
      "next_action": "Decide on a direction given this frame"
    },
    "decide": {
      "request_placeholder": "one-line scrubbed user request",
      "artifact": [
        "### Options compared",
        "",
        "<table or list of options with tradeoffs>",
        "",
        "### Recommendation",
        "",
        "<chosen direction + rationale + risks>"
      ],
      "rationale_gate": "본질/근본 (essence/foundation) + Standards/Root-Cause gate",
      "evidence_pointers": "phase notes / files / artifacts",
      "next_action": "Compose the artifact for the chosen direction"
    },
    "compose": {
      "profiles": [
        "plan",
        "code"
      ],
      "default_profile": "plan",
      "request_placeholder": "one-line scrubbed user request",
      "artifact": [
        "### Artifact",
        "",
        "<plan: TDD task list, dependencies, success criteria",
        " OR code: list of changed files with one-line summary each>"
      ],
      "rationale_gate": "본질/근본 (essence/foundation) + Standards/Root-Cause gate",
      "evidence_pointers": "phase notes / files / artifacts",
      "next_action": "Critique the composed artifact"
    },
    "critique": {
      "profiles": [
        "default",
        "full-codebase"
      ],
      "default_profile": "default",
      "request_placeholder": "one-line scrubbed user request",
      "artifact": [
        "### Findings",
        "",
        "<severity-grouped findings: CRITICAL / MAJOR / MINOR / SUGGESTION>"
      ],
      "rationale_gate": "본질/근본 (essence/foundation) + Standards/Root-Cause gate",
      "evidence_pointers": "phase notes / files / artifacts",
      "next_action": "Refine to address findings"
    },
    "refine": {
      "request_placeholder": "one-line scrubbed user request",
      "artifact": [
        "### Changes applied",
        "",
        "<list of edited files with one-line summary; test/lint/type-check status>",
        "",
        "### Verification",
        "",
        "<test results, regression checks, root-cause confirmation>"
      ],
      "rationale_gate": "본질/근본 (essence/foundation) + Standards/Root-Cause gate",
      "evidence_pointers": "phase notes / files / artifacts",
      "next_action": "Critique to verify, or investigate deeper if root cause is uncertain",
      "terminal_requires_convergence": false
    },
    "start": {
      "request_placeholder": "feature description"
    }
  }
}
