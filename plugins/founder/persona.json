{
  "schema": "persona-declaration-1.1",
  "name": "founder",
  "deliverable_noun": "business deliverable",
  "runtime_footer_floor": "0.79.0",
  "capabilities": {
    "dispatch_target": false,
    "commit_surface": false,
    "legacy_homes": false,
    "profile_presets": false
  },
  "decide": {
    "fallback": {
      "preset_id": "default",
      "axes": [
        {
          "id": "market-attractiveness",
          "labels": {
            "en": "Market Attractiveness",
            "ko": "시장성"
          },
          "question": "Is there a real, reachable market of sufficient size, growth, and timing — a customer problem worth solving at scale, not just a feature nobody is asking for?",
          "role": "decisive",
          "gate": false
        },
        {
          "id": "unit-economics",
          "labels": {
            "en": "Unit Economics",
            "ko": "단위경제"
          },
          "question": "Do the unit economics work — can a customer be acquired and served for meaningfully less than the value captured, with a credible path to positive contribution margin?",
          "role": "decisive",
          "gate": false
        },
        {
          "id": "willingness-to-pay",
          "labels": {
            "en": "Willingness to Pay",
            "ko": "지불의사"
          },
          "question": "Is there behavioral evidence customers will actually pay (or engage at the required intensity) — demand demonstrated by action, not merely stated interest in a survey?",
          "role": "supporting",
          "gate": false
        },
        {
          "id": "competitive-intensity",
          "labels": {
            "en": "Competitive Intensity",
            "ko": "경쟁강도"
          },
          "question": "How crowded and defensible is the space — is there a wedge or unfair advantage that compounds, or is this a saturated, undifferentiated race to the bottom?",
          "role": "supporting",
          "gate": false
        },
        {
          "id": "regulatory-exposure",
          "labels": {
            "en": "Regulatory Exposure",
            "ko": "규제노출"
          },
          "question": "Does this clear licensing, compliance, and regulatory requirements for the target jurisdiction(s)? A hard regulatory blocker is a VETO gate, not a tradeoff — it overrides market and unit-economics strength until mitigated.",
          "role": "supporting",
          "gate": true
        },
        {
          "id": "safety-risk",
          "labels": {
            "en": "Safety / Harm Risk",
            "ko": "안전리스크"
          },
          "question": "Are safety, liability, privacy, and ethical-harm exposures acceptable and mitigable? An unmitigated safety or harm risk is a VETO gate that overrides market and unit-economics strength until addressed.",
          "role": "supporting",
          "gate": true
        }
      ]
    },
    "size_presets": {
      "minor": "compact",
      "standard": "default",
      "major": "default"
    }
  },
  "verbs": {
    "investigate": {
      "profiles": [
        "business-brief"
      ],
      "default_profile": "business-brief",
      "request_placeholder": "one-line genericized business topic",
      "ensemble_type": "research-scan",
      "artifact": [
        "### Brief saved",
        "",
        "<absolute path to business_brief.md>"
      ],
      "rationale_gate": "본질/근본 (essence/foundation) + evidence-quality gate",
      "evidence_pointers": "brief path / sub-questions / Open Questions",
      "next_action": "<one-sentence imperative for next verb>"
    },
    "frame": {
      "request_placeholder": "one-line genericized business topic",
      "artifact": [
        "### Opportunity model",
        "",
        "Problem / Opportunity: ...",
        "Customer + Job-to-be-Done: ...",
        "Value hypothesis: ...",
        "Business-model sketch: ...",
        "Constraints: ...",
        "Validation criteria: ...",
        "Key risks: ...",
        "Out of scope: ..."
      ],
      "rationale_gate": "본질/근본 (essence/foundation) + evidence-quality gate",
      "evidence_pointers": "opportunity-model fields / brief path",
      "next_action": "Decide on a business direction given this frame"
    },
    "decide": {
      "request_placeholder": "one-line genericized business decision",
      "artifact": [
        "### Directions compared",
        "",
        "<table or list of directions with tradeoffs across the resolved business axes>",
        "",
        "### Recommendation",
        "",
        "<chosen direction + rationale + gate verdict (regulatory/safety) + risks>"
      ],
      "rationale_gate": "decisive 시장성/단위경제 (market/unit-economics) + the regulatory/safety gate verdict",
      "evidence_pointers": "phase notes / brief / artifacts",
      "next_action": "Compose the planning artifact for the chosen direction"
    },
    "compose": {
      "profiles": [
        "plan",
        "canvas",
        "validation-plan"
      ],
      "default_profile": "plan",
      "request_placeholder": "one-line genericized planning target",
      "artifact": [
        "### Artifact",
        "",
        "<the planning artifact: venture plan sections / lean canvas boxes /",
        " validation-plan experiments — with [to be validated] markers on",
        " unverified assumptions>"
      ],
      "rationale_gate": "본질/근본 (essence/foundation) + evidence-quality gate",
      "evidence_pointers": "plan sections / brief path",
      "next_action": "Critique the composed planning artifact"
    },
    "refine": {
      "terminal_requires_convergence": false
    },
    "start": {
      "terminal_requires_convergence": false
    }
  }
}
