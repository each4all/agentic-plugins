{
  "name": "agentic-plugins",
  "version": "0.1.0",
  "description": "Cross-host AI agent collaboration framework — Claude Code & Codex CLI",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/each4all/agentic-plugins.git"
  },
  "homepage": "https://github.com/each4all/agentic-plugins",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test --test-timeout=120000",
    "lint:plugin-shape": "for d in plugins/*/; do node kit/lint/check-plugin-shape.mjs \"$d\" || exit 1; done",
    "test:smoke": "COMPANIONS_SMOKE=1 node --test companions/tests/claude-companion.smoke.mjs companions/tests/codex-companion.smoke.mjs",
    "validate:marketplace": "node scripts/validate-marketplace.mjs",
    "validate:versions": "node scripts/validate-versions.mjs",
    "validate:artifacts": "node scripts/validate-artifacts.mjs",
    "mutate": "node scripts/mutation-harness.mjs",
    "sync:companions": "node scripts/sync-companion-bundles.mjs",
    "sync:marketplace": "node scripts/sync-marketplace-versions.mjs",
    "sync:persona-pipeline": "node scripts/sync-persona-pipeline.mjs"
  },
  "bin": {
    "claude-companion": "./companions/claude-companion.mjs",
    "codex-companion": "./companions/codex-companion.mjs"
  }
}
